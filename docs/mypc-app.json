{
  "mypc": 1,
  "id": "hearth-horizon",
  "name": "Hearth & Horizon",
  "description": "Ultra-optimized home fireplace, cinematic stone fireplace, rain & ambient screensavers with open-source game fire VFX and high-resolution audio",
  "type": "app",
  "entry": "index.html",
  "icon": "icon.svg",
  "version": "1.7.0",
  "config": {
    "allow_background_running": false,
    "defaultScene": "hearth",
    "defaultMode": "screensaver",
    "qualityTier": "auto",
    "fireplaceQuality": "maximum",
    "fireEffectStyle": "game_flipbook",
    "viewMode": "wide",
    "cameraZoom": 1.0,
    "showDiagnostics": false,
    "clockFormat": "24h",
    "showClock": true,
    "showSeconds": false,
    "showDate": true,
    "showAmbientBadge": true,
    "hudAutoHideSec": 12,
    "burnInProtection": true,
    "pixelOrbitRange": 14,
    "peakLuminance": 100,
    "colorTemp": "natural",
    "autoCycleMinutes": 0,
    "sleepTimerMinutes": 0,
    "fireIntensity": 0.85,
    "emberDensity": 0.8,
    "flameHeight": 0.8,
    "rainIntensity": 0.75,
    "windSpeed": 0.35,
    "lightningFreq": 0.4,
    "masterAudio": true,
    "openSourceStreams": true,
    "videos": []
  },
  "widgets": [
    {
      "id": "ambient",
      "title": {
        "en": "Hearth & Horizon",
        "fr": "Foyer & Horizon",
        "es": "Hogar y Horizonte",
        "ar": "الموقد والأفق"
      },
      "file": "widgets/ambient.js",
      "size": "medium",
      "every": 30,
      "background": false,
      "description": "Quickly launch Home Fireplace, Cinematic Fireplace, or Midnight Rain screensaver",
      "settings": [
        {
          "id": "scene",
          "label": {
            "en": "Default Scene",
            "fr": "Scène par défaut",
            "es": "Escena predeterminada",
            "ar": "المشهد الافتراضي"
          },
          "type": "select",
          "default": "hearth",
          "options": [
            { "value": "hearth", "label": "Home Fireplace" },
            { "value": "cinematic", "label": "Cinematic Fireplace" },
            { "value": "rain", "label": "Midnight Rain" },
            { "value": "aurora", "label": "Aurora Fjord" },
            { "value": "ocean", "label": "Deep Reef" },
            { "value": "zen", "label": "Zen Koi Pond" }
          ]
        }
      ]
    }
  ]
}
